output "realm" {
  value = keycloak_realm.poc.realm
}

output "web_frontend_client_id" {
  value = keycloak_openid_client.web_frontend.client_id
}

output "orchestrator_client_id" {
  value = keycloak_openid_client.orchestrator.client_id
}

output "orchestrator_client_secret" {
  description = "Generated by Keycloak; stored only in local Terraform state. Read with: terraform output -raw orchestrator_client_secret"
  value       = keycloak_openid_client.orchestrator.client_secret
  sensitive   = true
}

output "users" {
  description = "Provisioned users and whether they are enabled. Set their passwords in the admin console."
  value       = { for k, u in module.directory.users : k => u.enabled }
}
